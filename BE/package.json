{
  "name": "be",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build auth-service && nest build employee-service && nest build attendance-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "npm run start:auth",
    "start:dev": "npm run start:auth:dev",
    "start:auth": "nest start auth-service",
    "start:auth:dev": "nest start auth-service --watch",
    "start:employee": "nest start employee-service",
    "start:employee:dev": "nest start employee-service --watch",
    "start:attendance": "nest start attendance-service",
    "start:attendance:dev": "nest start attendance-service --watch",
    "start:all:dev": "concurrently -n auth,employee,attendance -c cyan,magenta,yellow \"npm run start:auth:dev\" \"npm run start:employee:dev\" \"npm run start:attendance:dev\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/auth-service/test/jest-e2e.json && jest --config ./apps/employee-service/test/jest-e2e.json && jest --config ./apps/attendance-service/test/jest-e2e.json",
    "prisma:generate:auth": "prisma generate --schema apps/auth-service/prisma/schema.prisma",
    "prisma:generate:employee": "prisma generate --schema apps/employee-service/prisma/schema.prisma",
    "prisma:generate:attendance": "prisma generate --schema apps/attendance-service/prisma/schema.prisma",
    "prisma:generate": "npm run prisma:generate:auth && npm run prisma:generate:employee && npm run prisma:generate:attendance",
    "prisma:push:auth": "prisma db push --schema apps/auth-service/prisma/schema.prisma",
    "prisma:push:employee": "prisma db push --schema apps/employee-service/prisma/schema.prisma",
    "prisma:push:attendance": "prisma db push --schema apps/attendance-service/prisma/schema.prisma",
    "prisma:push": "npm run prisma:push:auth && npm run prisma:push:employee && npm run prisma:push:attendance",
    "db:seed:auth": "ts-node --transpile-only apps/auth-service/prisma/seed.ts",
    "db:seed:employee": "ts-node --transpile-only apps/employee-service/prisma/seed.ts",
    "db:seed:attendance": "ts-node --transpile-only apps/attendance-service/prisma/seed.ts",
    "db:seed": "npm run db:seed:auth && npm run db:seed:employee && npm run db:seed:attendance",
    "db:setup": "npm run prisma:generate && npm run prisma:push && npm run db:seed"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^5.22.0",
    "multer": "^1.4.5-lts.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/"
    ]
  }
}
