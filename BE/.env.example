# Shared
CORS_ORIGIN=http://localhost:5173
AUTH_INTERNAL_TOKEN=internal-service-token

# Service Ports
AUTH_PORT=3001
EMPLOYEE_PORT=3002
ATTENDANCE_PORT=3003

# Service URLs
AUTH_SERVICE_URL=http://localhost:3001
EMPLOYEE_SERVICE_URL=http://localhost:3002
ATTENDANCE_SERVICE_URL=http://localhost:3003

# Databases (single MySQL container, different DB per service)
AUTH_DATABASE_URL=mysql://root:root@localhost:3306/auth_db
EMPLOYEE_DATABASE_URL=mysql://root:root@localhost:3306/employee_db
ATTENDANCE_DATABASE_URL=mysql://root:root@localhost:3306/attendance_db
